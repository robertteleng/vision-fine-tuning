# =============================================================================
# Fine-Tuning YOLO Project - .gitignore
# =============================================================================

# -----------------------------------------------------------------------------
# Datos y Datasets (grandes, no versionables)
# -----------------------------------------------------------------------------
/data/
*.zip
*.tar.gz
*.rar

# -----------------------------------------------------------------------------
# Modelos entrenados y checkpoints
# -----------------------------------------------------------------------------
/models/*
!/models/yolo26s_nav.pt
!/models/yolo26n_nav.pt
/runs/
*.pt
!models/yolo26s_nav.pt
!models/yolo26n_nav.pt
*.pth
*.onnx
# explicit INT8 (Q/DQ) models: the shared source of INT8 scales for every device
!/models/qdq/
!/models/qdq/*.onnx
*.engine
*.mlmodel
*.tflite
*.pb

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# -----------------------------------------------------------------------------
# Entornos virtuales
# -----------------------------------------------------------------------------
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
.conda/

# -----------------------------------------------------------------------------
# Jupyter Notebooks
# -----------------------------------------------------------------------------
.ipynb_checkpoints/
*.ipynb_checkpoints
*/.ipynb_checkpoints/*

# -----------------------------------------------------------------------------
# IDEs y Editores
# -----------------------------------------------------------------------------
.claude/worktrees/
.claude/settings.local.json
.idea/
.vscode/
*.swp
*.swo
*~
.project
.pydevproject
.settings/
*.sublime-workspace
*.sublime-project

# -----------------------------------------------------------------------------
# Logs y outputs temporales
# -----------------------------------------------------------------------------
*.log
logs/
*.tmp
*.temp
.cache/

# -----------------------------------------------------------------------------
# Sistema operativo
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# -----------------------------------------------------------------------------
# Configuración local y secretos
# -----------------------------------------------------------------------------
.env.local
.env.*.local
secrets.yaml
*_secret*
*.key

# -----------------------------------------------------------------------------
# TensorBoard
# -----------------------------------------------------------------------------
tensorboard_logs/
tb_logs/

# -----------------------------------------------------------------------------
# Archivos de resultados grandes
# -----------------------------------------------------------------------------
*.mp4
*.avi
*.mov
results/
# benchmark records are the source of every published number
!/benchmarks/results/
outputs/

# -----------------------------------------------------------------------------
# Tooling de desarrollo con IA (solo local, no forma parte del proyecto)
# -----------------------------------------------------------------------------
.claude/
CLAUDE.md
AGENTS.md
PAIR_WORKFLOW.md
DEVELOPER_DIARY.md
NEXT_SESSION.md
docs/teamwork/
docs/development/
docs/workflows/
docs/research/
docs/project/
docs/DOCUMENTATION_GUIDE.md
scripts/architecture/
.pytest_cache/

# Workspace tooling synced from a private template: never part of this public repo
CLAUDE.md
AGENTS.md
.claude/
docs/teamwork/
docs/design/
docs/development/
docs/workflows/
docs/project/SHIP_READINESS_CHECKLIST.md
docs/research/templates/
scripts/architecture/
PAIR_WORKFLOW.md
DEVELOPER_DIARY.md
NEXT_SESSION.md
